# git apply compares patch and target bytes, and the vendored checkouts are not
# line-ending uniform: external/ECS.hpp commits CRLF in its blob. A patch that
# targets such a file must therefore be checked out with CRLF on every host, or
# the same patch applies on Windows (where the working tree default is CRLF) and
# fails on Linux. Everything else stays on the repository default (LF).
cmake/patches/ecs-shared-default-table.patch text eol=crlf
cmake/patches/ecs-view-preparation.patch text eol=crlf
cmake/patches/ecs-idle-commit.patch text eol=crlf
cmake/patches/ecs-view-scope-and-iteration.patch text eol=crlf
cmake/patches/zeroerr-compiled-diagnostics.patch text eol=lf
cmake/patches/ecs-view-live-slots.patch text eol=crlf
cmake/patches/ecs-query-and-record-lifetime.patch text eol=crlf
cmake/patches/simplesquirrel-module-type-identity.patch text eol=lf
