{
  "source": "../../examples/iso-grid-walk/assets/source",
  "output": "../../examples/iso-grid-walk/assets/generated",
  "plugins": [],
  "pipeline": [
    {
      "use": "scan",
      "options": {
        "glob": "tile_*.png",
        "gidRegex": "tile_(\\d+)",
        "firstGid": 1
      }
    },
    {
      "use": "analyze",
      "options": {
        "alphaThreshold": 1,
        "pivot": [0.5, 0.75],
        "footprint": [1, 1]
      }
    },
    {
      "use": "pack",
      "options": {
        "maxWidth": 2048,
        "padding": 2
      }
    },
    {
      "use": "emit",
      "options": {
        "atlas": "tiles.atlas.png",
        "manifest": "tiles.tileset.json",
        "runtimeImage": "assets/generated/tiles.atlas.png"
      }
    }
  ],
  "overrides": {
    "tile_77": {
      "walkable": false,
      "tags": ["wall"],
      "sortBias": 4
    }
  }
}
