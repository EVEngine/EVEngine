@PACKAGE_INIT@

set(EVENGINE_VERSION "@EVENGINE_SDK_VERSION@")
set(EVENGINE_TARGET_PLATFORM "@EVENGINE_TARGET_PLATFORM@")

get_filename_component(EVENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(EVENGINE_INCLUDE_DIR "${EVENGINE_ROOT}/include/eve")
set(EVENGINE_THIRD_PARTY_INCLUDE_DIR "${EVENGINE_ROOT}/include")
set(EVENGINE_BIN_DIR "${EVENGINE_ROOT}/bin")
set(EVENGINE_LIB_DIR "${EVENGINE_ROOT}/lib")
set(EVENGINE_PLATFORM_DIR "${EVENGINE_ROOT}/platform")

include("${CMAKE_CURRENT_LIST_DIR}/EVEnginePlugin.cmake")

check_required_components(EVEngine)
