# Select the dependency package before registering ExternalProject targets.
function(eve_resolve_third_party_release)
    if(NOT EVENGINE_THIRD_PARTY_MODE MATCHES "^(AUTO|PREBUILT|SOURCE)$")
        message(FATAL_ERROR "EVENGINE_THIRD_PARTY_MODE must be AUTO, PREBUILT or SOURCE")
    endif()
    if(EVENGINE_THIRD_PARTY_MODE STREQUAL "SOURCE")
        set(EVENGINE_THIRD_PARTY_BINARY_DIR "" CACHE PATH "Third-party install prefix" FORCE)
        return()
    endif()
    if(EVENGINE_THIRD_PARTY_BINARY_DIR AND
       NOT EVENGINE_THIRD_PARTY_BINARY_DIR STREQUAL EVENGINE_TP_AUTOMATIC_PREFIX)
        return() # Explicit local prebuilt prefix remains supported.
    endif()
    set(_supported TRUE)
    set(_configuration Release)
    if(BUILD_PLATFORM STREQUAL "win32" AND CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(_configuration Debug)
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
    if(_processor MATCHES "^(amd64|x86_64|x64)$")
        set(_architecture x86_64)
    elseif(_processor MATCHES "^(aarch64|arm64)$")
        set(_architecture arm64)
    else()
        set(_supported FALSE)
    endif()
    if(BUILD_PLATFORM STREQUAL "win32" AND NOT _architecture STREQUAL "x86_64")
        set(_supported FALSE)
    elseif(BUILD_PLATFORM STREQUAL "linux" AND NOT _architecture STREQUAL "x86_64")
        set(_supported FALSE)
    elseif(BUILD_PLATFORM STREQUAL "android")
        if(ANDROID_ABI STREQUAL "arm64-v8a")
            set(_architecture arm64)
            set(_supported TRUE)
        else()
            set(_supported FALSE)
        endif()
    elseif(BUILD_PLATFORM STREQUAL "ios")
        set(_architecture arm64)
        if(CMAKE_OSX_SYSROOT MATCHES "simulator" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
            set(_supported FALSE)
        endif()
    elseif(NOT BUILD_PLATFORM MATCHES "^(win32|linux|macosx)$")
        set(_supported FALSE)
    endif()
    if(BUILD_PLATFORM STREQUAL "macosx" AND CMAKE_OSX_ARCHITECTURES)
        if(CMAKE_OSX_ARCHITECTURES MATCHES "^(x86_64|arm64)$")
            set(_architecture "${CMAKE_OSX_ARCHITECTURES}")
        else()
            set(_supported FALSE)
        endif()
    endif()
    # Instrumented/custom code-model builds require matching dependency objects.
    if(CMAKE_C_FLAGS MATCHES "sanitize|mcmodel" OR CMAKE_CXX_FLAGS MATCHES "sanitize|mcmodel")
        set(_supported FALSE)
    endif()
    if(NOT _supported)
        if(EVENGINE_THIRD_PARTY_MODE STREQUAL "PREBUILT")
            message(FATAL_ERROR "No published third-party package for this target; use EVENGINE_THIRD_PARTY_MODE=SOURCE")
        endif()
        if(EVENGINE_THIRD_PARTY_BINARY_DIR STREQUAL EVENGINE_TP_AUTOMATIC_PREFIX)
            set(EVENGINE_THIRD_PARTY_BINARY_DIR "" CACHE PATH "Third-party install prefix" FORCE)
        endif()
        message(STATUS "third-party: source build selected for an unpackaged target/toolchain")
        return()
    endif()
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(_prefix "${CMAKE_SOURCE_DIR}/build/third-party-releases/${EVENGINE_THIRD_PARTY_RELEASE}/${BUILD_PLATFORM}-${_architecture}-${_configuration}")
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_SOURCE_DIR}/scripts/third_party_package.py" "${BUILD_PLATFORM}"
        --tag "${EVENGINE_THIRD_PARTY_RELEASE}" --configuration "${_configuration}"
        --architecture "${_architecture}" --prefix "${_prefix}"
        RESULT_VARIABLE _result)
    # Exit 2 denotes download unavailability; corrupt/incompatible packages stay fatal.
    if(_result STREQUAL "2" AND EVENGINE_THIRD_PARTY_MODE STREQUAL "AUTO")
        set(EVENGINE_THIRD_PARTY_BINARY_DIR "" CACHE PATH "Third-party install prefix" FORCE)
        message(STATUS "third-party: release download unavailable; building pinned dependencies from source")
        return()
    endif()
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Failed to obtain the pinned third-party release. Publish its tag first, or explicitly use -DEVENGINE_THIRD_PARTY_MODE=SOURCE")
    endif()
    set(EVENGINE_TP_AUTOMATIC_PREFIX "${_prefix}" CACHE INTERNAL "Automatically resolved dependency release" FORCE)
    set(EVENGINE_THIRD_PARTY_BINARY_DIR "${_prefix}" CACHE PATH "Third-party install prefix" FORCE)
endfunction()
