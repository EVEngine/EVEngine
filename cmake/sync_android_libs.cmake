# Use native CMake operations: Windows shell processes can fail after linking.
foreach(required BUILD_DIR JNI_LIBS ANDROID_NDK ANDROID_ABI)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

set(main_lib "${BUILD_DIR}/src/engine/libmain.so")
if(EXISTS "${BUILD_DIR}/test/libmain.so")
    set(main_lib "${BUILD_DIR}/test/libmain.so")
    message(STATUS "Syncing test runner libmain.so")
endif()

get_filename_component(build_name "${BUILD_DIR}" NAME)
set(tp_dir "build/third-party-binary/${build_name}")
if(NOT IS_DIRECTORY "${tp_dir}/lib")
    set(tp_dir "build/third-party-binary/android-debug")
endif()
if(NOT IS_DIRECTORY "${tp_dir}/lib")
    set(tp_dir "build/third-party-binary/android")
endif()

if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(ndk_triple "aarch64-linux-android")
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    set(ndk_triple "arm-linux-androideabi")
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(ndk_triple "x86_64-linux-android")
elseif(ANDROID_ABI STREQUAL "x86")
    set(ndk_triple "i686-linux-android")
else()
    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
endif()
file(GLOB cxx_libs "${ANDROID_NDK}/toolchains/llvm/prebuilt/*/sysroot/usr/lib/${ndk_triple}/libc++_shared.so")
list(LENGTH cxx_libs cxx_count)
if(NOT cxx_count EQUAL 1)
    message(FATAL_ERROR "Expected one NDK libc++_shared.so, found ${cxx_count}")
endif()
set(libraries "${main_lib}" "${tp_dir}/lib/libSDL2.so" ${cxx_libs})
if(EXISTS "${tp_dir}/lib/libhidapi.so")
    list(APPEND libraries "${tp_dir}/lib/libhidapi.so")
endif()
foreach(library IN LISTS libraries)
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "Missing Android shared library: ${library}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${JNI_LIBS}")
file(COPY ${libraries} DESTINATION "${JNI_LIBS}")
message(STATUS "Synced native libs -> ${JNI_LIBS}")
