# Native staging avoids host shell conditionals during Windows Android builds.
foreach(required BUILD_DIR JNI_LIBS ANDROID_ABI ANDROID_NDK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Android library staging requires ${required}")
    endif()
endforeach()
if(NOT DEFINED REPO_ROOT)
    get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
get_filename_component(build_path "${BUILD_DIR}" ABSOLUTE BASE_DIR "${REPO_ROOT}")
get_filename_component(destination "${JNI_LIBS}" ABSOLUTE BASE_DIR "${REPO_ROOT}")
if(EXISTS "${build_path}/test/libmain.so")
    set(main_library "${build_path}/test/libmain.so")
else()
    set(main_library "${build_path}/src/engine/libmain.so")
endif()
set(cache_file "${build_path}/CMakeCache.txt")
if(NOT EXISTS "${cache_file}")
    message(FATAL_ERROR "Android build cache missing: ${cache_file}")
endif()
file(STRINGS "${cache_file}" tp_prefix_line
    REGEX "^EVENGINE_TP_INSTALL_PREFIX:INTERNAL=")
if(NOT tp_prefix_line)
    message(FATAL_ERROR "Third-party install prefix missing from ${cache_file}")
endif()
string(REGEX REPLACE "^EVENGINE_TP_INSTALL_PREFIX:INTERNAL=" "" third_party "${tp_prefix_line}")
if(NOT IS_DIRECTORY "${third_party}/lib")
    message(FATAL_ERROR "Third-party lib directory missing: ${third_party}/lib")
endif()
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(triple aarch64-linux-android)
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    set(triple arm-linux-androideabi)
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(triple x86_64-linux-android)
elseif(ANDROID_ABI STREQUAL "x86")
    set(triple i686-linux-android)
else()
    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
endif()
file(GLOB cpp_runtime "${ANDROID_NDK}/toolchains/llvm/prebuilt/*/sysroot/usr/lib/${triple}/libc++_shared.so")
list(LENGTH cpp_runtime runtime_count)
if(runtime_count LESS 1)
    message(FATAL_ERROR "NDK libc++_shared.so missing for ${ANDROID_ABI}")
endif()
set(libraries "${main_library}" "${third_party}/lib/libSDL2.so" ${cpp_runtime})
if(EXISTS "${third_party}/lib/libhidapi.so")
    list(APPEND libraries "${third_party}/lib/libhidapi.so")
endif()
foreach(library IN LISTS libraries)
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "Required Android library missing: ${library}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${destination}")
foreach(library IN LISTS libraries)
    get_filename_component(library_name "${library}" NAME)
    file(COPY_FILE "${library}" "${destination}/${library_name}" ONLY_IF_DIFFERENT)
endforeach()
message(STATUS "Synced native libs -> ${destination}")
