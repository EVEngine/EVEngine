+static int stbi__hdr_load_flat(stbi__context *s, float *output, int pixel_count, int req_comp, int first_pixel)
+{
+   // Keep flat decoding outside the scanline loops: the RLE path may switch
+   // to flat pixels, but must never jump into another loop's body.
+   int pixel;
+   for (pixel = first_pixel; pixel < pixel_count; ++pixel) {
+      stbi_uc rgbe[4];
+      if (!stbi__getn(s, rgbe, 4)) return 0;
+      stbi__hdr_convert(output + pixel * req_comp, rgbe, req_comp);
+   }
+   return 1;
+}
