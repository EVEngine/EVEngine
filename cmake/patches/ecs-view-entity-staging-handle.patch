+    /**
+     * @brief Constructs a staging record at a caller-chosen id (the reserved main id).
+     * @remarks Gaps below @p id are filled with dead placeholders so publish can
+     *          walk the dense index range and skip them.
+     */
+    template <typename... Args>
+    void emplace_at(uint32_t id, Args &&...args)
+    {
+      while (container.size() < id)
+      {
+        container.emplace_back();
+        T &hole = container.back();
+        hole.id = static_cast<uint32_t>(container.size() - 1);
+        hole.flags = kEntityDead;
+        hole.generation = 0;
+      }
+      if (id < container.size())
+      {
+        T &slot = container[id];
+        slot.~T();
+        new (&slot) T(std::forward<Args>(args)...);
+        return;
+      }
+      container.emplace_back(std::forward<Args>(args)...);
+    }
