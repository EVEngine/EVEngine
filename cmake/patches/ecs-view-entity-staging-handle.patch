+    uint32_t reserve_id()
+    {
+      uint32_t id = emplace();
+      T &slot = container[id];
+      slot.id = id;
+      slot.flags = kEntityStaging;
+      if (slot.generation == 0)
+        slot.generation = 1;
+      return id;
