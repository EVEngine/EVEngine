+    /// EVEngine extension: accumulated angular friction impulse, projected onto a sphere.
+    inline bool SolveVelocityConstraintWithLimit(Body &ioBody1, Body &ioBody2, float inLimit)
+    {
+        Vec3 previous = mTotalLambda;
+        Vec3 next = previous + mEffectiveMass.Multiply3x3(ioBody1.GetAngularVelocity() - ioBody2.GetAngularVelocity());
