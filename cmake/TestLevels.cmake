cmake_policy(PUSH)
cmake_policy(SET CMP0057 NEW)

# The source catalogue is checked and compiled once during configuration.
function(eve_configure_test_levels OUTPUT)
  get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_metadata "${CMAKE_CURRENT_BINARY_DIR}/test_levels.cmake")
  # Literal identities now come from C++; editing a test must refresh discovery
  # even when its file default needs no policy change.
  file(GLOB_RECURSE _level_sources "${_root}/test/*.cpp")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_root}/test/test_levels.json" "${_root}/scripts/test_levels.py" ${_level_sources})
  execute_process(
    COMMAND "${Python3_EXECUTABLE}" -X utf8 "${_root}/scripts/test_levels.py"
            --emit-cmake "${_metadata}"
    RESULT_VARIABLE _status ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "test level catalogue validation failed:\n${_error}")
  endif()
  set(${OUTPUT} "${_metadata}" PARENT_SCOPE)
endfunction()

# Resolve pre-reorganization source names used by profile/standalone contracts.
# A formerly mixed source resolves to two real translation units. Merged sources
# resolve once, preserving profile exclusions without duplicate registrations.
function(eve_resolve_test_sources OUTPUT)
  set(_result)
  set(_seen)
  foreach(_source IN LISTS ARGN)
    get_filename_component(_basename "${_source}" NAME)
    get_filename_component(_input_path "${_source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(DEFINED EVE_TEST_RELOCATED_${_basename} AND NOT EXISTS "${_input_path}")
      foreach(_actual IN LISTS EVE_TEST_RELOCATED_${_basename})
        if(NOT _actual IN_LIST _seen)
          list(APPEND _result "${_actual}")
          list(APPEND _seen "${_actual}")
        endif()
      endforeach()
    else()
      if(EXISTS "${_input_path}")
        if(NOT _input_path IN_LIST _seen)
          list(APPEND _result "${_source}")
          list(APPEND _seen "${_input_path}")
        endif()
      else()
        list(APPEND _result "${_source}")
      endif()
    endif()
  endforeach()
  set(${OUTPUT} "${_result}" PARENT_SCOPE)
endfunction()

# Keep profile/standalone source exclusions when multiple origins share a TU.
# Definitions are derived from the same migration catalogue as source resolution.
function(eve_test_origin_definitions OUTPUT)
  set(_definitions)
  foreach(_source IN LISTS ARGN)
    get_filename_component(_basename "${_source}" NAME)
    get_filename_component(_input "${_source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(DEFINED EVE_TEST_RELOCATED_${_basename} AND NOT EXISTS "${_input}")
      # Integration aliases resolve to complete physical sources. Only the
      # unchanged consolidated unit suites still need their legacy guards.
      set(_legacy_unit_selection OFF)
      foreach(_actual IN LISTS EVE_TEST_RELOCATED_${_basename})
        file(TO_CMAKE_PATH "${_actual}" _path)
        if(NOT _path MATCHES "(^|/)integration/")
          set(_legacy_unit_selection ON)
        endif()
      endforeach()
      if(_legacy_unit_selection)
        get_filename_component(_origin "${_source}" NAME_WE)
        list(APPEND _definitions "EVE_TEST_ORIGIN_${_origin}")
      endif()
    endif()
  endforeach()
  if(_definitions)
    list(REMOVE_DUPLICATES _definitions)
    list(PREPEND _definitions EVE_TEST_FILTER_ORIGINS)
  endif()
  set(${OUTPUT} "${_definitions}" PARENT_SCOPE)
endfunction()

# A forced header avoids Windows cmd.exe limits for large monolithic selections.
# It is target-owned build data; shared SOURCE properties must never hold this.
function(eve_apply_test_origin_definitions TARGET)
  get_target_property(_definitions ${TARGET} EVE_TEST_ORIGIN_DEFINITIONS)
  if(NOT _definitions)
    set(_definitions)
  endif()
  list(APPEND _definitions ${ARGN})
  list(REMOVE_DUPLICATES _definitions)
  if(NOT _definitions)
    return()
  endif()
  set_property(TARGET ${TARGET} PROPERTY EVE_TEST_ORIGIN_DEFINITIONS "${_definitions}")
  set(_header "${CMAKE_CURRENT_BINARY_DIR}/test-origins/${TARGET}.h")
  set(_content "#pragma once\n// Generated from the test source catalogue and target selection.\n")
  foreach(_definition IN LISTS _definitions)
    string(APPEND _content "#define ${_definition} 1\n")
  endforeach()
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/test-origins")
  if(EXISTS "${_header}")
    file(READ "${_header}" _previous)
  endif()
  if(NOT _previous STREQUAL _content)
    file(WRITE "${_header}" "${_content}")
  endif()
  string(SHA256 _revision "${_content}")
  get_target_property(_compile_definitions ${TARGET} COMPILE_DEFINITIONS)
  if(NOT _compile_definitions)
    set(_compile_definitions)
  endif()
  list(FILTER _compile_definitions EXCLUDE REGEX "^EVE_TEST_ORIGIN_SELECTION_REVISION=")
  list(APPEND _compile_definitions "EVE_TEST_ORIGIN_SELECTION_REVISION=selection_${_revision}")
  set_property(TARGET ${TARGET} PROPERTY COMPILE_DEFINITIONS "${_compile_definitions}")
  get_target_property(_attached ${TARGET} EVE_TEST_ORIGIN_HEADER)
  if(NOT _attached)
    set_property(TARGET ${TARGET} PROPERTY EVE_TEST_ORIGIN_HEADER "${_header}")
    if(MSVC)
      target_compile_options(${TARGET} PRIVATE "/FI${_header}")
    else()
      target_compile_options(${TARGET} PRIVATE -include "${_header}")
    endif()
  endif()
endfunction()

function(eve_add_test_executable TARGET)
  eve_test_origin_definitions(_definitions ${ARGN})
  eve_resolve_test_sources(_sources ${ARGN})
  add_executable(${TARGET} ${_sources})
  eve_apply_test_origin_definitions(${TARGET} ${_definitions})
  get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  target_include_directories(${TARGET} PRIVATE "${_root}/test")
endfunction()

function(eve_target_test_sources TARGET)
  eve_test_origin_definitions(_definitions ${ARGN})
  eve_resolve_test_sources(_sources ${ARGN})
  target_sources(${TARGET} ${_sources})
  eve_apply_test_origin_definitions(${TARGET} ${_definitions})
endfunction()

function(eve_test_source_properties)
  set(_sources)
  set(_properties)
  set(_reading_properties OFF)
  foreach(_arg IN LISTS ARGN)
    if(_arg STREQUAL "PROPERTIES")
      set(_reading_properties ON)
    elseif(_reading_properties)
      list(APPEND _properties "${_arg}")
    else()
      list(APPEND _sources "${_arg}")
    endif()
  endforeach()
  eve_resolve_test_sources(_sources ${_sources})
  set_source_files_properties(${_sources} PROPERTIES ${_properties})
endfunction()

function(eve_test_metadata SOURCE NAME OUTPUT)
  get_filename_component(_source "${SOURCE}" NAME)
  set(_key "EVE_TEST_LEVEL_${_source}|${NAME}")
  if(DEFINED "${_key}")
    set(${OUTPUT} "${${_key}}" PARENT_SCOPE)
    return()
  endif()
  # Only explicitly inventoried generator macros may use a source default.
  # A newly discovered literal case or unknown source is never auto-classified.
  foreach(_prefix IN LISTS EVE_TEST_GENERATED_${_source})
    string(FIND "${NAME}" "${_prefix}" _position)
    if(_position EQUAL 0)
      set(_default "EVE_TEST_LEVEL_${_source}|")
      set(${OUTPUT} "${${_default}}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "unclassified C++ test: ${SOURCE}:${NAME}; update test/test_levels.json and reconfigure")
endfunction()

# Static CTest registrations in focused CPU/profile projects consume the same
# case policy as runtime discovery. Existing domain/CPU labels stay intact.
function(eve_label_test_case TEST SOURCE NAME)
  eve_test_metadata("${SOURCE}" "${NAME}" _metadata)
  get_filename_component(_source "${SOURCE}" NAME)
  set_property(TEST "${TEST}" APPEND PROPERTY LABELS "source:${_source};${_metadata}")
  if("unit" IN_LIST _metadata)
    set_property(TEST "${TEST}" APPEND PROPERTY ENVIRONMENT "EVENGINE_TEST_NO_RENDER=1")
  endif()
endfunction()

# Script-mode discovery also needs the unit runtime contract, while preserving
# the SHARED loader's existing PATH/LD_LIBRARY_PATH environment entry.
function(eve_test_runtime_environment METADATA BASE OUTPUT)
  set(_environment "${BASE}")
  if("unit" IN_LIST METADATA)
    if(_environment STREQUAL "")
      set(_environment " ENVIRONMENT \"EVENGINE_TEST_NO_RENDER=1\"")
    else()
      string(REGEX REPLACE "\"$" ";EVENGINE_TEST_NO_RENDER=1\"" _environment "${_environment}")
    endif()
  endif()
  set(${OUTPUT} "${_environment}" PARENT_SCOPE)
endfunction()

function(eve_merge_test_metadata OUTPUT)
  set(_levels "")
  set(_requirements "")
  foreach(_label IN LISTS ARGN)
    if(_label STREQUAL "unit" OR _label STREQUAL "integration")
      list(APPEND _levels "${_label}")
    elseif(_label MATCHES "^requires:")
      list(APPEND _requirements "${_label}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _levels)
  list(REMOVE_DUPLICATES _requirements)
  list(LENGTH _levels _count)
  if(_count GREATER 1)
    set(_levels mixed)
  endif()
  set(_labels "${_levels}")
  if(_requirements)
    list(APPEND _labels ${_requirements})
  endif()
  list(FIND _requirements "requires:graphics" _graphics)
  list(FIND _requirements "requires:window" _window)
  if(_graphics EQUAL -1 AND _window EQUAL -1)
    list(APPEND _labels no-render)
  endif()
  set(${OUTPUT} "${_labels}" PARENT_SCOPE)
endfunction()

# Literal registrations must follow compiled origin selection, not every case
# physically present in a consolidated source.
function(eve_test_source_case_names SOURCE OUTPUT TARGET)
  get_filename_component(_basename "${SOURCE}" NAME)
  set(_names ${EVE_TEST_CASE_NAMES_${_basename}})
  # Integration responsibilities are physical sources now. A unit consumer's
  # legacy selection must not hide cases compiled from those sources.
  file(TO_CMAKE_PATH "${SOURCE}" _path)
  if(_path MATCHES "(^|/)integration/")
    set(${OUTPUT} "${_names}" PARENT_SCOPE)
    return()
  endif()
  get_target_property(_definitions "${TARGET}" EVE_TEST_ORIGIN_DEFINITIONS)
  if("EVE_TEST_FILTER_ORIGINS" IN_LIST _definitions)
    set(_allowed)
    foreach(_definition IN LISTS _definitions)
      if(_definition MATCHES "^EVE_TEST_ORIGIN_(.+)$")
        set(_origin_key "EVE_TEST_ORIGIN_CASE_NAMES_${CMAKE_MATCH_1}.cpp")
        if(DEFINED ${_origin_key})
          list(APPEND _allowed ${${_origin_key}})
        else()
          list(APPEND _allowed ${EVE_TEST_CASE_NAMES_${CMAKE_MATCH_1}.cpp})
        endif()
      endif()
    endforeach()
    set(_selected ${EVE_TEST_ALWAYS_CASE_NAMES_${_basename}})
    foreach(_name IN LISTS _names)
      if(_name IN_LIST _allowed)
        list(APPEND _selected "${_name}")
      endif()
    endforeach()
    list(REMOVE_DUPLICATES _selected)
    set(_names ${_selected})
  endif()
  set(${OUTPUT} "${_names}" PARENT_SCOPE)
endfunction()

# Standalone aggregate runners keep their names and assertion diagnostics. Their
# label is the union of their sources; a mixed group never becomes a unit test.
function(eve_label_test_group TEST)
  set(_metadata "")
  foreach(_source IN LISTS ARGN)
    get_filename_component(_basename "${_source}" NAME)
    set(_names ${EVE_TEST_CASE_NAMES_${_basename}})
    if(_names)
      foreach(_name IN LISTS _names)
        eve_test_metadata("${_source}" "${_name}" _case_metadata)
        list(APPEND _metadata ${_case_metadata})
      endforeach()
    else()
      set(_key "EVE_TEST_LEVEL_${_basename}|")
      if(NOT DEFINED "${_key}")
        message(FATAL_ERROR "unclassified C++ source: ${_source}")
      endif()
      list(APPEND _metadata ${${_key}})
    endif()
  endforeach()
  eve_merge_test_metadata(_labels ${_metadata})
  set_property(TEST "${TEST}" APPEND PROPERTY LABELS "${_labels}")
endfunction()

# Literal regex plus CMake serialization escaping are separate steps. Writing
# a single backslash into generated quoted CMake code produces invalid escapes.
function(eve_test_regex_literal INPUT OUTPUT)
  string(REPLACE "\\" "\\\\" _literal "${INPUT}")
  foreach(_character IN ITEMS "." "+" "*" "?" "^" "$" "(" ")" "[" "]" "{" "}" "|")
    string(REPLACE "${_character}" "\\${_character}" _literal "${_literal}")
  endforeach()
  set(${OUTPUT} "${_literal}" PARENT_SCOPE)
endfunction()

function(eve_test_cmake_string INPUT OUTPUT)
  string(REPLACE "\\" "\\\\" _escaped "${INPUT}")
  string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
  set(${OUTPUT} "${_escaped}" PARENT_SCOPE)
endfunction()

# One real fixture object serves desktop and independently enabled profile checks.
function(eve_ensure_graphics_window_fixtures)
  if(TARGET eve_graphics_window_fixtures)
    return()
  endif()
  get_filename_component(_eve_fixture_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  add_library(eve_graphics_window_fixtures STATIC "${_eve_fixture_root}/test/GraphicsWindowFixtures.cpp")
  # Fixtures.h reaches Assimp's generated config.h through Graphics.h.
  add_dependencies(eve_graphics_window_fixtures third-party)
  target_link_libraries(eve_graphics_window_fixtures PRIVATE eve_engine_includes zeroerr)
  target_compile_options(eve_graphics_window_fixtures PRIVATE
    $<$<CXX_COMPILER_ID:MSVC>:/UZEROERR_NO_ASSERT>
    $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-UZEROERR_NO_ASSERT>)
  if(WIN32)
    target_compile_definitions(eve_graphics_window_fixtures PRIVATE
      POCO_STATIC POCO_NO_AUTOMATIC_LIBS NOMINMAX)
  endif()
endfunction()

cmake_policy(POP)
