# Keep installed dependencies and the pinned checkout read-only. Generate one
# canonical header overlay with the existing ssq::Class ABI and addFunc API.
function(eve_prepare_simplesquirrel_headers)
    if(EVENGINE_THIRD_PARTY_BINARY_DIR)
        set(_source "${EVENGINE_THIRD_PARTY_BINARY_DIR}/include/simplesquirrel")
    else()
        set(_source "${CMAKE_SOURCE_DIR}/third-party/simplesquirrel/include/simplesquirrel")
    endif()
    set(_root "${CMAKE_BINARY_DIR}/generated/simplesquirrel")
    file(GLOB_RECURSE _headers CONFIGURE_DEPENDS RELATIVE "${_source}" "${_source}/*.hpp")
    if(NOT EXISTS "${_source}/class.hpp")
        message(FATAL_ERROR "Missing pinned SimpleSquirrel class.hpp: ${_source}")
    endif()
    foreach(_header IN LISTS _headers)
        if(NOT _header STREQUAL "class.hpp" AND NOT _header STREQUAL "table.hpp")
            configure_file("${_source}/${_header}" "${_root}/simplesquirrel/${_header}" COPYONLY)
        endif()
    endforeach()
    file(READ "${_source}/class.hpp" _class)
    set(_old "            auto func = std::function<Return(Object*, Args...)>(std::mem_fn(memfunc));\n            return addFunc(name, func, isStatic);")
    string(REPLACE "\r\n" "\n" _class "${_class}")
    string(REGEX MATCHALL "std::mem_fn\\(memfunc\\)" _matches "${_class}")
    list(LENGTH _matches _count)
    if(NOT _count EQUAL 2)
        message(FATAL_ERROR "SimpleSquirrel member binding changed; review the direct-member overlay")
    endif()
    set(_new "            if (vm == nullptr) throw RuntimeException(\"VM is not initialised\");\n            Function ret(vm);\n            sq_pushobject(vm, obj);\n            detail::DirectMember<decltype(memfunc)>::bind(vm, name, memfunc, isStatic);\n            sq_pop(vm, 1);\n            return ret;")
    string(REPLACE "${_old}" "${_new}" _class "${_class}")
    if(_class MATCHES "std::mem_fn\\(memfunc\\)")
        message(FATAL_ERROR "SimpleSquirrel direct-member patch did not match the pinned header")
    endif()
    string(REPLACE "#include \"binding.hpp\"" "#include \"binding.hpp\"\n#include \"direct_member.hpp\"" _class "${_class}")
    set(_old_lambda "            return addFunc(name, detail::make_function(lambda), isStatic);")
    set(_new_lambda "            if constexpr (detail::directFunctionCompatible<F>) {\n                if (vm == nullptr) throw RuntimeException(\"VM is not initialised\");\n                Function ret(vm);\n                sq_pushobject(vm, obj);\n                detail::DirectFunction<decltype(+lambda), true>::bind(vm, name, +lambda, isStatic);\n                sq_pop(vm, 1);\n                return ret;\n            } else {\n                return addFunc(name, detail::make_function(lambda), isStatic);\n            }")
    string(FIND "${_class}" "${_old_lambda}" _lambda_pos)
    if(_lambda_pos LESS 0)
        message(FATAL_ERROR "SimpleSquirrel class callable binding changed; review the overlay")
    endif()
    string(REPLACE "${_old_lambda}" "${_new_lambda}" _class "${_class}")
    file(WRITE "${_root}/class.hpp.in" "${_class}")
    configure_file("${_root}/class.hpp.in" "${_root}/simplesquirrel/class.hpp" COPYONLY)
    file(READ "${_source}/table.hpp" _table)
    string(REPLACE "\r\n" "\n" _table "${_table}")
    set(_old_lambda "            return addFunc(name, detail::make_function(lambda));")
    set(_new_lambda "            if constexpr (detail::directFunctionCompatible<F>) {\n                Function ret(vm);\n                sq_pushobject(vm, obj);\n                detail::DirectFunction<decltype(+lambda), false>::bind(vm, name, +lambda);\n                sq_pop(vm, 1);\n                return ret;\n            } else {\n                return addFunc(name, detail::make_function(lambda));\n            }")
    string(FIND "${_table}" "${_old_lambda}" _lambda_pos)
    if(_lambda_pos LESS 0)
        message(FATAL_ERROR "SimpleSquirrel table callable binding changed; review the overlay")
    endif()
    string(REPLACE "${_old_lambda}" "${_new_lambda}" _table "${_table}")
    file(WRITE "${_root}/table.hpp.in" "${_table}")
    configure_file("${_root}/table.hpp.in" "${_root}/simplesquirrel/table.hpp" COPYONLY)
    configure_file("${CMAKE_SOURCE_DIR}/cmake/overrides/simplesquirrel/direct_member.hpp"
        "${_root}/simplesquirrel/direct_member.hpp" COPYONLY)
    target_include_directories(eve_engine_includes BEFORE INTERFACE "${_root}")
    # A duplicate /external:I path changes MSVC's search order when ccache
    # rewrites it relative to base_dir; keep this overlay first as plain /I.
    if(NOT MSVC)
        eve_external_include("${_root}")
    endif()
endfunction()
