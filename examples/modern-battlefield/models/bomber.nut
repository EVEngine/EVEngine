// Long-range turboprop bomber: high swept wing, four independent six-blade propellers.
export function buildBomber(m,a) {
    local paint=[0.40,0.44,0.46],edge=[0.54,0.56,0.55],metal=[0.22,0.27,0.29],black=[0.035,0.05,0.06],glass=[0.10,0.27,0.34],tip=[0.66,0.58,0.28];
    a.air=true;
    m.hullLoft([[-7.1,0.12,-0.1,0.12],[-5.1,0.55,-0.4,0.6],[-2.2,0.85,-0.66,0.85],[2.8,0.84,-0.67,0.85],[5.2,0.65,-0.50,0.63],[6.6,0.35,-0.20,0.35],[7.2,0.06,-0.05,0.08]],paint);
    m.hullLoft([[3.7,0.42,0.60,0.72],[4.2,0.56,0.52,1.0],[5.15,0.47,0.42,0.90],[5.65,0.30,0.3,0.50]],glass,"body",0.12);
    foreach(s in [-1,1]) {
        m.wingPanel([[s*0.65,2.0],[s*8.8,-2.1],[s*9.0,-3.25],[s*6.8,-3.5],[s*0.7,-0.5]],0.42,0.19,paint);
        m.wingPanel([[s*0.3,-4.9],[s*3.3,-6.0],[s*3.3,-6.7],[s*0.2,-6.1]],0.45,0.12,paint);
        m.braceBeam([s*0.7,0.55,-0.2],[s*8.7,0.55,-3.0],0.025,metal);
        m.braceBeam([s*0.52,0.75,4.2],[s*0.38,0.5,5.6],0.05,metal);
        m.braceBeam([s*0.52,0.75,4.2],[s*0.46,0.91,4.6],0.05,metal);
        m.armorBox(s*8.8,0.58,-2.65,0.18,0.04,0.3,s<0?[0.5,0.04,0.03]:[0.03,0.4,0.14]);
        for(local k=0;k<3;k++) m.armorBox(s*(5.2+k*0.14),0.535,-2.4,0.065,0.012,0.5,metal);
    }
    m.finPlate([[-6.8,0.25],[-6.7,2.9],[-5.9,3.5],[-4.8,0.5]],0,0.17,paint);
    m.finPlate([[-6.6,2.7],[-6.55,2.93],[-5.9,3.5],[-5.75,3.2]],0,0.19,metal);
    for(local i=0;i<4;i++) {
        local s=i<2?-1:1,x=s*(i%2==0?3.0:5.6),z=i%2==0?0.45:-0.8;
        m.armorBox(x,-0.10,z-0.1,0.20,0.75,1.0,metal);
        m.profileTube(x,-0.45,z,[[-1.45,0.25],[-1.1,0.43],[0.65,0.44],[1.0,0.28]],paint);
        m.roundTube(x,-0.45,z-1.47,0.18,0.025,black);
        m.setJointPivot("prop"+i,x,-0.45,z+1.10);
        m.profileTube(0,0,0,[[-0.10,0.26],[0.12,0.25],[0.5,0.03]],metal,"prop"+i);
        for(local k=0;k<6;k++) {
            local t=k*1.0472,verts=[];
            foreach(p in [[0.18,-0.08],[1.35,-0.20],[1.52,0.02],[0.30,0.17]])
                verts.push([p[0]*cos(t)-p[1]*sin(t),p[0]*sin(t)+p[1]*cos(t),0.0]);
            m.bakeFaces(verts,[[0,1,2,3],[3,2,1,0]],metal,"prop"+i);
            local v=[];
            foreach(p in [[1.28,-0.19],[1.35,-0.20],[1.52,0.02],[1.35,0.04]])
                v.push([p[0]*cos(t)-p[1]*sin(t),p[0]*sin(t)+p[1]*cos(t),0.006]);
            m.bakeFaces(v,[[0,1,2,3],[3,2,1,0]],tip,"prop"+i);
        }
    }
    m.armorBox(0,-0.68,0,1.1,0.04,3.0,metal);
    m.armorBox(0,-0.707,0,0.025,0.012,2.9,black);
    foreach(z in [-3.0,-1.0,1.0]) m.armorBox(0,0.96,z,0.04,0.24,0.28,metal);
}
