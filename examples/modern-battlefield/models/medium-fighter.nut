// Twin-engine multirole fighter: pointed radome, swept wings, twin tails, intakes.
export function buildMediumFighter(m,a) {
    local paint=[0.31,0.37,0.42],edge=[0.44,0.49,0.51],metal=[0.16,0.21,0.25],black=[0.03,0.045,0.06],glass=[0.08,0.24,0.33],nozzle=[0.31,0.27,0.22];
    a.air=true;
    m.hullLoft([[-4.8,0.5,-0.3,0.2],[-3.3,1.04,-0.43,0.5],[-0.3,1.14,-0.45,0.50],[1.4,0.8,-0.45,0.45],[3.7,0.40,-0.23,0.30],[4.35,0.25,-0.12,0.19]],paint);
    m.hullLoft([[4.35,0.25,-0.12,0.19],[5.1,0.14,-0.06,0.13],[5.75,0.015,0.02,0.04]],metal);
    m.hullLoft([[0.9,0.28,0.42,0.51],[1.4,0.37,0.38,0.95],[2.5,0.34,0.31,0.90],[3.25,0.22,0.25,0.36]],glass,"body",0.18);
    m.hullLoft([[-3.2,0.24,0.38,0.62],[-0.5,0.25,0.40,0.68],[1.0,0.20,0.40,0.51]],paint);
    foreach(s in [-1,1]) {
        m.wingPanel([[s*0.7,1.7],[s*4.7,-1.7],[s*4.85,-2.50],[s*1.0,-2.0]],-0.05,0.13,paint);
        m.wingPanel([[s*0.7,2.15],[s*1.7,0.6],[s*1.6,-0.3],[s*0.7,-0.6]],0.0,0.09,edge);
        m.wingPanel([[s*0.5,-2.9],[s*2.7,-3.8],[s*2.5,-4.65],[s*0.6,-4.1]],0.08,0.10,paint);
        m.finPlate([[-4.4,0.1],[-4.05,1.9],[-3.25,2.15],[-2.5,0.3]],s*0.86,0.14,paint);
        m.finPlate([[-4.05,1.80],[-4.05,1.94],[-3.25,2.15],[-3.12,1.97]],s*0.86,0.16,metal);
        m.armorBox(s*0.74,-0.38,0.90,0.60,0.60,1.15,paint,"body",0,0.08,s*0.18);
        m.armorBox(s*0.74,-0.37,1.49,0.43,0.42,0.025,black,"body",0,0.08,s*0.18);
        m.armorBox(s*0.76,-0.03,1.1,0.65,0.07,0.9,edge,"body",0,0.08,s*0.18);
        m.profileTube(s*0.53,-0.18,-4.25,[[-0.75,0.34],[-0.6,0.41],[0.6,0.43],[0.85,0.38]],metal);
        m.roundTube(s*0.53,-0.18,-5.01,0.28,0.015,black);
        m.roundTube(s*0.53,-0.18,-5.02,0.12,0.018,[0.62,0.25,0.07]);
        for(local i=0;i<16;i++) {
            local t=i*0.3927;
            m.braceBeam([s*0.53+cos(t)*0.39,-0.18+sin(t)*0.39,-4.65],
                [s*0.53+cos(t)*0.34,-0.18+sin(t)*0.34,-4.98],0.055,nozzle);
        }
        m.braceBeam([s*0.9,0.027,-1.85],[s*4.5,0.027,-2.30],0.02,metal);
        m.braceBeam([s*0.35,0.41,1.4],[s*0.22,0.34,3.25],0.045,metal);
        m.profileTube(s*4.65,-0.08,-1.35,[[-1.05,0.065],[0.75,0.065],[1.2,0.01]],edge);
        m.wingPanel([[s*4.35,-1.9],[s*4.95,-1.9],[s*4.95,-2.4],[s*4.35,-2.4]],-0.08,0.035,metal);
        m.armorBox(s*2.5,-0.26,-0.75,0.12,0.35,0.7,metal);
        m.profileTube(s*2.5,-0.53,-0.55,[[-0.9,0.11],[0.75,0.11],[1.10,0.01]],edge);
        m.wingPanel([[s*1.25,-0.25],[s*1.9,-0.65],[s*1.9,-1.0],[s*1.25,-0.65]],0.035,0.013,metal);
        m.armorBox(s*0.58,0.42,-0.8,0.10,0.04,0.50,metal);
    }
    m.armorBox(0,-0.47,0.1,0.34,0.2,1.9,metal);
    m.armorBox(0,0.66,-2.4,0.035,0.22,0.25,metal);
    m.roundTube(-0.49,0.18,2.4,0.04,0.45,metal);
}
