schema "eve.dnut"
version 1

// 单一 dnut 文档同时拥有台词池和剧情图；DialogueFlow 原子编译并提交两者。

pool alice.greet noRepeat=3 {
    when mood == "happy" && hour >= 18 {
        alice: "晚上好呀，{name}！今天过得怎么样？" weight=2 meta(expression="happy", motion="wave") tags=["greet","evening"]
        alice: "你来啦，我正想着你呢。" weight=1 meta(expression="happy") tags=["greet"]
    }
    when mood == "happy" {
        alice: "嗨，{name}！今天心情不错吧？" weight=2 meta(expression="happy") tags=["greet"]
        alice: "见到你真高兴！" weight=1 meta(expression="happy") tags=["greet"]
    }
    when mood == "shy" {
        alice: "那个……你、你好。" weight=1 meta(expression="shy") tags=["greet"]
    }
    alice: "……你好。" weight=1 tags=["greet"]
}

pool bob.greet noRepeat=2 {
    when hour >= 18 {
        bob: "晚上好。今天过得怎么样？" weight=2 meta(expression="neutral") tags=["greet","evening"]
    }
    bob: "嘿，{name}。" weight=1 meta(expression="neutral") tags=["greet"]
}

conversation demo.details entry=detail {
    parameter playerName string required
    node detail line speaker=bob text="Image、Live2D 与 VRM 后端都消费同一份当前节点。" i18n=line.image_layers voice=voice.demo.details next=end
    node end end
}

conversation demo.main entry=welcome {
    parameter playerName string required
    parameter evening bool optional default=true
    node welcome line speaker=alice pool=alice.greet i18n=line.hello voice=voice.demo.welcome next=decide
    node decide branch {
        route evening when="isEvening" target=ask
        route daytime target=ask
    }
    node ask choice {
        route continue text="继续" i18n=choice.yes target=details
        route leave text="下次再聊" i18n=choice.no target=bye
    }
    node details call target=demo.details return=wait_after arguments(playerName="Codex")
    node wait_after wait next=prepare
    node prepare command kind=operation target="demo.prepare" result="prepared" arguments(delay=0.8) next=done
    node bye line speaker=bob text="下次见。" i18n=line.bye next=end
    node done line speaker=alice text="异步准备完成；存档恢复后的 request ID 仍然有效。" i18n=line.end next=end
    node end end
}
