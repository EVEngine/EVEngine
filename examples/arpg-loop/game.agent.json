{
  "schemaId": "evengine.game-agent-contract",
  "schemaVersion": 1,
  "id": "examples/arpg-loop",
  "entry": "main.nut",
  "smoke": {
    "scene": "camp",
    "seed": 0,
    "maxHostFrames": 180,
    "mustReach": [
      "loop"
    ]
  },
  "clock": {
    "defaultStep": "frame"
  },
  "observations": [
    {
      "id": "loop",
      "kind": "script-root",
      "path": "gameState",
      "fields": [
        "tick",
        "zone",
        "hp",
        "enemyHp",
        "kills",
        "gold",
        "level",
        "attack",
        "items",
        "potions",
        "pendingLoot",
        "quest",
        "sideQuest",
        "px",
        "py",
        "ex",
        "ey",
        "windup",
        "dodge",
        "message",
        "cooldown",
        "heavyCooldown",
        "dodgeCooldown",
        "strike",
        "inputX",
        "inputY"
      ]
    }
  ],
  "actions": {
    "source": "script-map",
    "map": [
      {"id": "attack", "script": "game.attack()"},
      {"id": "heavy", "script": "game.heavy()"},
      {"id": "dodge", "script": "game.dodge()"},
      {"id": "right", "script": "game.right()"},
      {"id": "left", "script": "game.left()"},
      {"id": "up", "script": "game.up()"},
      {"id": "down", "script": "game.down()"},
      {"id": "stop", "script": "game.stop()"},
      {"id": "pickup", "script": "game.pickup()"},
      {"id": "equip", "script": "game.equip()"},
      {"id": "save", "script": "game.save()"},
      {"id": "load", "script": "game.load()"},
      {"id": "next", "script": "game.next()"},
      {"id": "reset", "script": "game.reset()"},
      {"id": "enterArena", "script": "game.enterArena()"},
      {"id": "returnCamp", "script": "game.returnCamp()"},
      {"id": "talk", "script": "game.talk()"},
      {"id": "buy", "script": "game.buy()"},
      {"id": "drink", "script": "game.drink()"}
    ]
  },
  "capture": {
    "requiredFor": ["visual"],
    "backend": "engine-readback"
  },
  "tolerances": {
    "screenshot": "human-or-vlm",
    "numericAbs": 0.0001
  }
}
