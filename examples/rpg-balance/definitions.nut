// Game-owned canonical definitions, registered once before isolated tournaments.
function balanceRegisterDefinitions() {
    local rpg = eve.RPG();
    if (rpg.registerTraitsFromJson(@"[{""id"":""balance.warrior"",""traits"":[{""kind"":""elementRate"",""target"":""wind"",""value"":0.6},{""kind"":""elementRate"",""target"":""fire"",""value"":1.4}]},{""id"":""balance.mage"",""traits"":[{""kind"":""elementRate"",""target"":""slash"",""value"":0.6},{""kind"":""elementRate"",""target"":""wind"",""value"":1.4}]},{""id"":""balance.ranger"",""traits"":[{""kind"":""elementRate"",""target"":""fire"",""value"":0.6},{""kind"":""elementRate"",""target"":""slash"",""value"":1.4}]}]") != 3) throw "Traits registration failed";
    if (rpg.registerClassesFromJson(@"[{""id"":""balance.warrior"",""traits"":[""balance.warrior""]},{""id"":""balance.mage"",""traits"":[""balance.mage""]},{""id"":""balance.ranger"",""traits"":[""balance.ranger""]}]") != 3) throw "Classes registration failed";
    if (rpg.registerEffectsFromJson(@"[{""id"":""balance.guard"",""durationPolicy"":""duration"",""duration"":3,""stackPolicy"":""refresh"",""modifiers"":[{""attribute"":""def"",""op"":""add"",""value"":8}]},{""id"":""balance.poison"",""durationPolicy"":""duration"",""duration"":4,""period"":1,""stackPolicy"":""refresh"",""extra"":{""settlement.tick"":""{\""kind\"": \""damage\"", \""resource\"": \""hp\"", \""magnitude\"": 5}""}}]") != 2) throw "Effects registration failed";
    if (rpg.registerSkillsFromJson(@"[{""id"":""balance.strike"",""cooldown"":2,""targetType"":""enemySingle"",""costs"":[{""attribute"":""mana"",""amount"":8}],""tags"":[""burst""]},{""id"":""balance.guard"",""cooldown"":5,""targetType"":""self"",""costs"":[{""attribute"":""mana"",""amount"":4}],""grantedEffects"":[""balance.guard""],""tags"":[""defense""]},{""id"":""balance.fire"",""cooldown"":2,""targetType"":""enemySingle"",""costs"":[{""attribute"":""mana"",""amount"":14}],""tags"":[""burst""]},{""id"":""balance.frost"",""cooldown"":1,""targetType"":""enemySingle"",""costs"":[{""attribute"":""mana"",""amount"":5}],""tags"":[""attack""]},{""id"":""balance.heal"",""cooldown"":4,""targetType"":""self"",""costs"":[{""attribute"":""mana"",""amount"":12}],""tags"":[""heal""]},{""id"":""balance.arrow"",""cooldown"":1,""targetType"":""enemySingle"",""costs"":[{""attribute"":""mana"",""amount"":5}],""tags"":[""attack"",""burst""]},{""id"":""balance.poison"",""cooldown"":5,""targetType"":""enemySingle"",""costs"":[{""attribute"":""mana"",""amount"":7}],""grantedEffects"":[""balance.poison""],""tags"":[""dot""]}]") != 7) throw "Skills registration failed";
    if (rpg.registerSkillDamage("balance.strike","hp","a.atk * a.power - b.def","slash",0.12,95) != 1) throw "Damage registration failed";
    if (rpg.registerSkillDamage("balance.fire","hp","a.mat * a.power - b.mdf","fire",0.12,95) != 1) throw "Damage registration failed";
    if (rpg.registerSkillDamage("balance.frost","hp","a.mat * a.power * 0.55 - b.mdf","ice",0.12,95) != 1) throw "Damage registration failed";
    if (rpg.registerSkillDamage("balance.heal","hpHeal","a.mat * 1.5","",0.12,95) != 1) throw "Damage registration failed";
    if (rpg.registerSkillDamage("balance.arrow","hp","a.atk * a.power - b.def * 0.6","wind",0.12,95) != 1) throw "Damage registration failed";
}
