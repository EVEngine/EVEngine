#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { vec2 value[]; } sourceField;
layout(set=0,binding=1,std430) writeonly buffer Output { float value[]; } outputField;
layout(set=0,binding=2,std430) writeonly buffer Atlas { float value[]; } atlas;
layout(push_constant) uniform Params { float data[32]; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uint(p.data[0])) return;
    outputField.value[i]=sourceField.value[i].x;
    uint n=uint(p.data[1]);
    if(i<3*n*n) atlas.value[i%n+(i/n+uint(p.data[3]))*uint(p.data[2])]=sourceField.value[i].x;
}
