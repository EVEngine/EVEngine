#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Coefficients { vec4 value[]; } coefficients;
layout(set=0,binding=1,std430) writeonly buffer Output { vec2 value[]; } outputField;
layout(push_constant) uniform Params { float data[32]; } p;
vec2 multiply(vec2 a,vec2 b) { return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x); }
vec2 phase(float a) { return vec2(cos(a),sin(a)); }
uint reverseIndex(uint value,uint n) {
    uint result=0;
    for(uint bit=1;bit<n;bit<<=1) { result=(result<<1)|(value&1);value>>=1; }
    return result;
}
void main() {
    uint n=uint(p.data[0]),count=n*n,i=gl_GlobalInvocationID.x;
    if(i>=6*count) return;
    uint field=i/count,index=i%count;
    vec4 c=coefficients.value[2*index],k=coefficients.value[2*index+1];
    vec2 forward=multiply(c.xy,phase(-(k.z+k.w)*p.data[1]));
    vec2 backward=multiply(c.zw,phase((k.z-k.w)*p.data[1]));
    vec2 height=forward+backward;
    vec2 velocity=multiply(vec2(0,k.z),backward-forward);
    float magnitude=length(k.xy);
    vec2 factor=field%3==1 ? vec2(1,0) : (magnitude>0 ? vec2(0,(field%3==0?k.x:k.y)/magnitude) : vec2(0));
    vec2 firstD=multiply(factor,height)*(field%3==1?1:p.data[2]);
    vec2 firstV=multiply(factor,velocity)*(field%3==1?1:p.data[2]);
    vec2 value=field<3 ? firstD : firstV;
    if(p.data[3]>0.5) {
        vec4 next=coefficients.value[2*(index+count)];
        vec2 f=multiply(next.xy,phase(-(k.z+k.w)*p.data[1]));
        vec2 b=multiply(next.zw,phase((k.z-k.w)*p.data[1]));
        vec2 nextD=multiply(factor,f+b)*(field%3==1?1:p.data[6]);
        vec2 nextV=multiply(factor,multiply(vec2(0,k.z),b-f))*(field%3==1?1:p.data[6]);
        value=field<3 ? mix(firstD,nextD,p.data[4]) : mix(firstV,nextV,p.data[4])+p.data[5]*(nextD-firstD);
        if(field==4 && index==0) value.x+=p.data[7];
    }
    uint destination=reverseIndex(index%n,n)+n*reverseIndex(index/n,n)+field*count;
    outputField.value[destination]=value;
}
