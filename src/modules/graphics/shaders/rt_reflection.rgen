#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, rgba16f) uniform image2D outImage;
layout(binding = 2) uniform sampler2D sceneColor;
layout(binding = 3) uniform sampler2D hwDepth;
layout(binding = 4) uniform sampler2D worldNormal;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    vec4 eye; // xyz
} pc;

layout(location = 0) rayPayloadEXT vec4 payload;

void main() {
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 size  = ivec2(gl_LaunchSizeEXT.xy);
    const vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);

    float depth = texture(hwDepth, uv).r;
    // Far plane / empty: no reflection
    if (depth >= 0.9999) {
        imageStore(outImage, pixel, vec4(0.0));
        return;
    }

    // Reconstruct world position from depth (Vulkan RH + ZO, NDC y down-ish via UV).
    vec2 ndc = uv * 2.0 - 1.0;
    // Vulkan clip space y is inverted relative to OpenGL; match engine RH+ZO convention.
    vec4 clip = vec4(ndc.x, ndc.y, depth, 1.0);
    vec4 worldH = pc.invViewProj * clip;
    vec3 worldPos = worldH.xyz / max(worldH.w, 1e-6);

    vec3 N = normalize(texture(worldNormal, uv).xyz * 2.0 - 1.0);
    vec3 V = normalize(pc.eye.xyz - worldPos);
    vec3 R = reflect(-V, N);

    payload = vec4(0.0);
    const uint rayFlags = gl_RayFlagsOpaqueEXT;
    const float tMin = 0.05;
    const float tMax = 1000.0;
    traceRayEXT(topLevelAS, rayFlags, 0xFF, 0, 0, 0, worldPos, tMin, R, tMax, 0);

    if (payload.a > 0.5) {
        // Hit: sample scene color at the projected hit (payload.rgb = approx radiance).
        imageStore(outImage, pixel, vec4(payload.rgb, 1.0));
    } else {
        imageStore(outImage, pixel, vec4(0.0));
    }
}
