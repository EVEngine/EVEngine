#version 450

layout(local_size_x = 64) in;

struct Particle {
    vec4 positionVelocity;
    vec4 lifeSizeRotation;
    vec4 motion;
    vec4 accelerationNoise;
};

struct Meta {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
    uint alive;
    uint spawned;
    uint killed;
    uint dropped;
};

layout(std430, set = 0, binding = 0) readonly buffer PreviousParticles {
    Particle particles[];
} previousState;
layout(std430, set = 0, binding = 1) writeonly buffer CurrentParticles {
    Particle particles[];
} currentState;
layout(std430, set = 0, binding = 2) readonly buffer SpawnParticles {
    Particle particles[];
} spawnState;
layout(std430, set = 0, binding = 3) readonly buffer PreviousMeta {
    Meta value;
} previousMeta;
layout(std430, set = 0, binding = 4) buffer CurrentMeta {
    Meta value;
} currentMeta;

layout(push_constant) uniform PushConstants {
    vec4 stepEmitterX;
    vec4 forces0;
    vec4 forces1;
    vec2 localOffset;
    uint capacity;
    uint spawnCount;
} pc;

float hashNoise(int ix, int iy) {
    uint h = uint(ix) * 374761393u + uint(iy) * 668265263u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    return (float((h ^ (h >> 16u)) & 0xFFFFFFu) / float(0x1000000)) * 2.0 - 1.0;
}

float valueNoise(float x, float y) {
    int ix = int(floor(x));
    int iy = int(floor(y));
    float fx = x - float(ix);
    float fy = y - float(iy);
    float sx = fx * fx * (3.0 - 2.0 * fx);
    float sy = fy * fy * (3.0 - 2.0 * fy);
    float n00 = hashNoise(ix, iy);
    float n10 = hashNoise(ix + 1, iy);
    float n01 = hashNoise(ix, iy + 1);
    float n11 = hashNoise(ix + 1, iy + 1);
    return mix(mix(n00, n10, sx), mix(n01, n11, sx), sy);
}

void appendParticle(Particle particle, bool spawned) {
    uint outputIndex = atomicAdd(currentMeta.value.alive, 1u);
    if (outputIndex >= pc.capacity) {
        atomicAdd(currentMeta.value.dropped, 1u);
        return;
    }
    currentState.particles[outputIndex] = particle;
    atomicAdd(currentMeta.value.instanceCount, 1u);
    if (spawned) atomicAdd(currentMeta.value.spawned, 1u);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.capacity) return;
    if (i == 0u) {
        currentMeta.value.vertexCount = 6u;
        currentMeta.value.firstVertex = 0u;
        currentMeta.value.firstInstance = 0u;
    }

    if (i < previousMeta.value.alive) {
        Particle particle = previousState.particles[i];
        float dt = pc.stepEmitterX.x;
        particle.lifeSizeRotation.x -= dt;
        if (particle.lifeSizeRotation.x > 0.0) {
            float x = particle.positionVelocity.x;
            float y = particle.positionVelocity.y;
            float vx = particle.positionVelocity.z;
            float vy = particle.positionVelocity.w;
            float ax = particle.accelerationNoise.x + pc.stepEmitterX.w;
            float ay = particle.accelerationNoise.y + pc.forces0.x;

            float dx = x - pc.stepEmitterX.y;
            float dy = y - pc.stepEmitterX.z;
            float len2 = dx * dx + dy * dy;
            if (len2 > 1e-6) {
                float inv = inversesqrt(len2);
                ax += dx * inv * particle.motion.z - dy * inv * particle.motion.w;
                ay += dy * inv * particle.motion.z + dx * inv * particle.motion.w;
            }

            if (pc.forces0.w != 0.0) {
                float phase = particle.accelerationNoise.z;
                float clock = pc.forces1.z * pc.forces1.y;
                ax += valueNoise(x * pc.forces1.x + clock, y * pc.forces1.x + phase) *
                      pc.forces0.w;
                ay += valueNoise(y * pc.forces1.x + clock, x * pc.forces1.x - phase) *
                      pc.forces0.w;
            }

            vx += ax * dt;
            vy += ay * dt;
            if (pc.forces0.y > 0.0) {
                float damping = max(0.0, 1.0 - pc.forces0.y * dt);
                vx *= damping;
                vy *= damping;
            }
            if (pc.forces0.z > 0.0) {
                float speed2 = vx * vx + vy * vy;
                float limit2 = pc.forces0.z * pc.forces0.z;
                if (speed2 > limit2) {
                    float scale = sqrt(limit2 / speed2);
                    vx *= scale;
                    vy *= scale;
                }
            }

            particle.positionVelocity =
                vec4(x + vx * dt + pc.localOffset.x, y + vy * dt + pc.localOffset.y, vx, vy);
            particle.lifeSizeRotation.w += particle.motion.x * dt;
            particle.motion.y += pc.forces1.w * dt;
            appendParticle(particle, false);
        } else {
            atomicAdd(currentMeta.value.killed, 1u);
        }
    }

    if (i < pc.spawnCount) appendParticle(spawnState.particles[i], true);
}
