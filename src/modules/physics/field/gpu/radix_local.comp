#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer InputKeys { uvec2 rows[]; } inputKeys;
layout(set = 0, binding = 1, std430) writeonly buffer LocalZeroBefore { uint rows[]; } localZeroBefore;
layout(set = 0, binding = 2, std430) writeonly buffer GroupZeroCount { uint rows[]; } groupZeroCount;
layout(push_constant) uniform Parameters { float values[32]; } parameters;
shared uint prefix[256];

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    uint bit = uint(parameters.values[3]);
    uint isZero = id < uint(parameters.values[0]) && ((inputKeys.rows[id].x >> bit) & 1u) == 0u ? 1u : 0u;
    prefix[lane] = isZero;
    barrier();
    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        uint lower = lane >= stride ? prefix[lane - stride] : 0u;
        barrier();
        prefix[lane] += lower;
        barrier();
    }
    if (id < uint(parameters.values[0])) localZeroBefore.rows[id] = prefix[lane] - isZero;
    if (lane == 255u) groupZeroCount.rows[gl_WorkGroupID.x] = prefix[lane];
}
