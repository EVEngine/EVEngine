#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer ChunkZeroCount { uint rows[]; } chunkZeroCount;
layout(set = 0, binding = 1, std430) writeonly buffer ChunkZeroBefore { uint rows[]; } chunkZeroBefore;
layout(set = 0, binding = 2, std430) writeonly buffer TotalZeros { uint value; } totalZeros;
layout(push_constant) uniform Parameters { float values[32]; } parameters;
shared uint prefix[256];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint value = lane < uint(parameters.values[2]) ? chunkZeroCount.rows[lane] : 0u;
    prefix[lane] = value;
    barrier();
    for (uint stride = 1u; stride < 256u; stride <<= 1u) {
        uint lower = lane >= stride ? prefix[lane - stride] : 0u;
        barrier();
        prefix[lane] += lower;
        barrier();
    }
    if (lane < uint(parameters.values[2])) chunkZeroBefore.rows[lane] = prefix[lane] - value;
    if (lane == 255u) totalZeros.value = prefix[lane];
}
